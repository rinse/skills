{
  "description": "After a turn that edited files, block once and have traceless-edits inspect the edited prose.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/traceless-edits-stop.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
